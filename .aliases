alias zshconfig="vi ~/.zshrc"
alias gs="git status"
alias b="bundle"
alias oms="overmind start -f Procfile.dev"
alias y="yarn"
alias cat="bat"
alias dc="docker compose"
alias dcr="docker compose exec rails"

# Make scripts in this project more easily accessible

alias ftsio='source ~/.dotfiles/ftsio'
alias sumdog='source ~/.dotfiles/sumdog'
